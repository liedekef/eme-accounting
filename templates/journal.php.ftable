<?php
defined( 'ABSPATH' ) || exit;

$config     = \EMEVzw\Config::get();
$year       = isset( $_GET['year'] )       ? (int) $_GET['year']                : (int) gmdate( 'Y' );
$account_id = isset( $_GET['account_id'] ) ? (int) $_GET['account_id']          : 0;
$direction  = isset( $_GET['direction'] )  ? sanitize_key( $_GET['direction'] ) : '';
$edit_id    = isset( $_GET['edit'] )       ? (int) $_GET['edit']                : 0;

$accounts     = EMEAccounting\Accounts::get_dropdown();
$coa_accounts = EMEAccounting\ChartOfAccounts::get_dropdown();
$years        = range( (int) gmdate( 'Y' ), (int) gmdate( 'Y' ) - 4 );

if ( empty( $accounts ) ) {
    echo '<div class="notice notice-error"><p>'
       . esc_html__( 'Maak eerst financiële rekeningen aan.', 'eme-accounting' )
       . '</p></div>';
    return;
}

$active_accounts = array_filter( $accounts, function ( $id ) {
    $a = EMEAccounting\Accounts::get( $id );
    return $a && $a->is_active;
}, ARRAY_FILTER_USE_KEY );

// Build JS-side data arrays ------------------------------------------------
$js_accounts = [];
foreach ( $active_accounts as $id => $name ) {
    $js_accounts[] = [ 'Value' => (string) $id, 'DisplayText' => $name ];
}

$js_coa = [];
foreach ( $coa_accounts as $id => $acc ) {
    if ( ! $acc || ! in_array( $acc->direction, [ 'in', 'out' ], true ) ) continue;
    $js_coa[] = [
        'Value'       => (string) $id,
        'DisplayText' => $acc->code . ' - ' . $acc->name,
        'Group'       => $acc->direction === 'in'
                         ? esc_html__( 'Ontvangsten', 'eme-accounting' )
                         : esc_html__( 'Uitgaven',    'eme-accounting' ),
        'direction'   => $acc->direction,
        'disabled'    => empty( $acc->parent_id ),
    ];
}
?>
<div class="wrap eme-acc-wrap">
    <h1><?php esc_html_e( 'Financieel Dagboek', 'eme-accounting' ); ?></h1>

    <!-- Filters -->
    <div class="eme-acc-toolbar">
        <form method="get" id="eme-acc-filter-form">
            <select name="year" id="eme-acc-year-filter">
                <option value=""><?php esc_html_e( 'Filter op boekjaar', 'eme-accounting' ); ?></option>
                <?php foreach ( $years as $y ): ?>
                <option value="<?= $y ?>"><?= $y ?></option>
                <?php endforeach; ?>
            </select>
            <input type="hidden" id="eme-daterange-filter" name="eme-daterange-filter">
            <input type="text" id="localized_daterange-filter"
                   placeholder="<?php esc_html_e( 'Filter op daterange', 'eme-accounting' ); ?>"
                   data-alt-field="eme-daterange-filter" data-autoclose="false"
                   data-range="true" data-multiple-separator=" -- " data-date=""
                   style="width:22ch" class="eme_formfield_fdate">
            <input type="search" placeholder="Filter op omschrijving" size="17"
                   name="eme-acc-search-filter" id="eme-acc-search-filter">
            <input type="search" placeholder="Bedrag" size="8"
                   name="eme-acc-amount-filter" id="eme-acc-amount-filter">
            <select name="account_id" id="eme-acc-account-filter">
                <option value="0"><?php esc_html_e( 'Alle rekeningen', 'eme-accounting' ); ?></option>
                <?php foreach ( $accounts as $aid => $aname ): ?>
                <option value="<?= $aid ?>" <?= selected( $aid, $account_id, false ) ?>>
                    <?= esc_html( $aname ) ?>
                </option>
                <?php endforeach; ?>
            </select>
            <select name="direction" id="eme-acc-direction-filter">
                <option value=""><?php esc_html_e( 'Alle richtingen', 'eme-accounting' ); ?></option>
                <option value="in"       <?= selected( 'in',       $direction, false ) ?>><?php esc_html_e( 'Ontvangsten', 'eme-accounting' ); ?></option>
                <option value="out"      <?= selected( 'out',      $direction, false ) ?>><?php esc_html_e( 'Uitgaven',    'eme-accounting' ); ?></option>
                <option value="transfer" <?= selected( 'transfer', $direction, false ) ?>><?php esc_html_e( 'Transfers',   'eme-accounting' ); ?></option>
            </select>
            <select name="coa_id" id="eme-acc-coa-filter" class="eme_snapselect" data-live-search="true">
                <option value=""><?php esc_html_e( '— Kies rekening —', 'eme-accounting' ); ?></option>
                <optgroup label="<?php esc_html_e( 'Ontvangsten', 'eme-accounting' ); ?>">
                <?php foreach ( $coa_accounts as $id => $acc ):
                    if ( $acc && $acc->direction === 'in' ): ?>
                <option value="<?= (int) $id ?>" <?php if ( empty( $acc->parent_id ) ) echo 'disabled'; ?>>
                    <?= esc_html( $acc->code . ' - ' . $acc->name ) ?>
                </option>
                <?php endif; endforeach; ?>
                </optgroup>
                <optgroup label="<?php esc_html_e( 'Uitgaven', 'eme-accounting' ); ?>">
                <?php foreach ( $coa_accounts as $id => $acc ):
                    if ( $acc && $acc->direction === 'out' ): ?>
                <option value="<?= (int) $id ?>" <?php if ( empty( $acc->parent_id ) ) echo 'disabled'; ?>>
                    <?= esc_html( $acc->code . ' - ' . $acc->name ) ?>
                </option>
                <?php endif; endforeach; ?>
                </optgroup>
            </select>
            <br>
            <?php echo eme_ui_select( 0, 'eme-acc-event-filter', [], '', 0, 'eme_snapselect_filterevents_class' ); //phpcs:ignore ?>
            <span>
                <input id="filter_eventsearch_all" value="1" type="checkbox">
                <?php esc_html_e( 'Check this box to search through all events and not just future ones.', 'events-made-easy' ); ?>
            </span>
            <button type="submit" class="button button-primary submit-btn">
                <?php esc_html_e( 'Filteren', 'eme-accounting' ); ?>
            </button>
        </form>
    </div>

    <!-- Boekingstabel (ftable beheert Add/Edit via modals) -->
    <div id="JournalTableContainer"></div>
</div>

<script>
var emeAccJournalData = {
    accounts : <?= wp_json_encode( array_values( $js_accounts ) ) ?>,
    coa      : <?= wp_json_encode( array_values( $js_coa ) ) ?>,
    editId   : <?= (int) $edit_id ?>,
    today    : <?= wp_json_encode( current_time( 'Y-m-d' ) ) ?>
};
</script>
